# Copy to .env for local dev (load with: set -a; . ./.env; set +a). Never commit .env.

# --- Dashboard -------------------------------------------------------------
DASHBOARD_PASSWORD=change-me-to-something-long
# Signs the dashboard session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Timezone for dates shown in the dashboard (IANA name)
DISPLAY_TZ=UTC
# Public URL of this app; used in the link inside escalation alerts. Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=http://localhost:5000
# Local http dev only: allow the session cookie over plain http. Leave unset in production.
SESSION_COOKIE_SECURE=0

# --- Database --------------------------------------------------------------
# Leave empty for local SQLite (instance/sentinel.db). Render fills this in from the Postgres service.
DATABASE_URL=

# --- Anthropic -------------------------------------------------------------
# Same key you already use for Mega-Net / Revenue Guard
ANTHROPIC_API_KEY=
# Model used for classification and all drafted messages. Default claude-haiku-5-5. Requests are plain text
# (no forced tool_choice, no thinking, no temperature), so any current Claude model works.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Permanent System User access token (see README step 5)
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp > API Setup (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; paste the same one into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to verify webhook signatures. Required.
WHATSAPP_APP_SECRET=
# Only for scripts/submit_templates.py: WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Local testing only (no app secret available): accept unsigned webhooks. Never set in production.
WHATSAPP_SKIP_SIGNATURE=0
WHATSAPP_API_VERSION=v23.0

# Template names/language, as approved in Meta. Defaults match scripts/submit_templates.py
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_DAY1=meganet_followup_day1
WHATSAPP_TEMPLATE_DAY3=meganet_followup_day3
WHATSAPP_TEMPLATE_DAY7=meganet_followup_day7
# First message sent to form/email leads who haven't messaged on WhatsApp yet (on by default; submit with --all)
WHATSAPP_TEMPLATE_ACK=meganet_inquiry_ack
# Alert to Fredrick when a lead is ready and his 24h window has lapsed (on by default; submit with --all)
WHATSAPP_TEMPLATE_ESCALATION=meganet_lead_alert

# --- Escalation ------------------------------------------------------------
# Fredrick's own WhatsApp number, digits only with country code (e.g. 2348012345678)
OWNER_WHATSAPP_NUMBER=
# Testing only (default off): treat messages FROM the owner number as a normal lead. Normally they are ignored
# (logged as "ignored (sender is OWNER_WHATSAPP_NUMBER ...)"). Turn off again after testing.
OWNER_AS_LEAD=0

# --- Waiting prospects (ready / paused / contacted leads who write again) --------
# Minimum hours between automatic "Fredrick has your message" replies to the same lead
HOLD_REPLY_COOLDOWN_HOURS=4
# Remind Fredrick if a waiting lead is still unanswered after this many minutes (then every 3 hours, max 3 times)
OWNER_REPLY_REMINDER_MINUTES=60
# Optional: also email every owner alert. ALL six must be set, otherwise email stays off silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Who handles a lead ---------------------------------------------------------
# Hours after an owner/staff message during which the bot only sends holding replies (the lead counts as human-handled)
OWNER_TAKEOVER_HOURS=48
# 1 = the bot keeps answering ready leads unless a person has taken over. 0 = old behaviour (ready means silent)
BOT_ANSWERS_AFTER_READY=1

# --- Existing clients and staff --------------------------------------------------
# Comma separated phone numbers (digits, with country code) of people who already use Mega-Net. They get the support
# route and support hours, never sales flows or menus. You can also toggle this on the lead page.
EXISTING_CLIENT_NUMBERS=
# Comma separated staff numbers: alerted about demo requests and allowed to send "confirm <id>" / "decline <id> [new time]"
STAFF_WHATSAPP_NUMBERS=

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=1
FOLLOWUP_CHECK_MINUTES=5
